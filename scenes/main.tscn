[gd_scene load_steps=2 format=3]

[ext_resource type="Script" path="res://scripts/hub.gd" id="1_hub"]

[node name="Main" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1_hub")

[node name="Background" type="ColorRect" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
color = Color(0.1, 0.11, 0.15, 1)

[node name="VBox" type="VBoxContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
offset_left = 40.0
offset_top = 24.0
offset_right = -40.0
offset_bottom = -24.0
grow_horizontal = 2
grow_vertical = 2
theme_override_constants/separation = 16

[node name="Header" type="VBoxContainer" parent="VBox"]
layout_mode = 2
theme_override_constants/separation = 4

[node name="Title" type="Label" parent="VBox/Header"]
layout_mode = 2
theme_override_colors/font_color = Color(0.98, 0.75, 0.45, 1)
theme_override_font_sizes/font_size = 26
text = "🎮 Lies-Of-Git — GameJam Starter Kit & Hub"

[node name="Subtitle" type="Label" parent="VBox/Header"]
layout_mode = 2
theme_override_colors/font_color = Color(0.7, 0.75, 0.85, 1)
text = "Cada maquete de jogo está pronta e isolada em sua própria branch Git. Escolha a sua favorita para começar a Jam!"

